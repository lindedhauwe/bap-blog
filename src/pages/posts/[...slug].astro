---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import TagPill from '../../components/TagPill.astro';
import { formatDate, url } from '../../consts';
import { getPosts } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, date, description, tags, cover, coverAlt, ai, draft } = post.data;
---

<Base title={title} description={description}>
  <article class="container">
    <a class="back muted" href={url()}>← All posts</a>
    <header>
      <time class="muted" datetime={date.toISOString()}>{formatDate(date)}</time>
      {draft && <strong class="draft">Draft</strong>}
      <h1>{title}</h1>
      <p class="lead muted">{description}</p>
      <div class="tags">{tags.map((tag) => <TagPill tag={tag} />)}</div>
    </header>

    {cover && <Image src={cover} alt={coverAlt ?? ''} class="cover" />}

    <div class="prose">
      <Content />
    </div>

    {ai && (
      <aside class="card ai">
        <h2>AI usage</h2>
        <p>{ai}</p>
      </aside>
    )}

    <nav class="pager">
      {older ? <a href={url(`posts/${older.id}/`)}>← {older.data.title}</a> : <span />}
      {newer && <a href={url(`posts/${newer.id}/`)}>{newer.data.title} →</a>}
    </nav>
  </article>
</Base>

<style>
  .back { display: inline-block; margin-bottom: 2rem; text-decoration: none; font-size: .95rem; }
  header { margin-bottom: 2rem; }
  .lead { font-size: 1.15rem; margin: 0 0 1rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .35rem; }
  .draft { margin-left: .5rem; font-size: .8rem; color: var(--tag-design); }
  .cover { width: 100%; margin-bottom: 2rem; }
  .ai { margin-top: 3rem; border-left: 4px solid var(--tag-ux); }
  .ai h2 { font-size: 1rem; margin: 0 0 .25rem; }
  .ai p { margin: 0; }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: .95rem;
  }
  .pager a { text-decoration: none; }
  .pager a:hover { text-decoration: underline; }
</style>
